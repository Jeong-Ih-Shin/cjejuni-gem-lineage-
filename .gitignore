# Generated by pipeline (re-run scripts to regenerate)
intermediate/*
output/figures/*

# GEM files are large binaries — keep them out of git, distribute separately (e.g. Zenodo)
gems/*.xml
gems/*.sbml

# Keep folder structure even when contents are gitignored
!intermediate/.gitkeep
!output/figures/.gitkeep
!gems/.gitkeep
!gems/README.md

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db
run_all.log
